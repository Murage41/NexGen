{
  "name": "nexgen-backend",
  "version": "1.0.0",
  "description": "NexGen Backend API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "knex migrate:latest --knexfile src/knexfile.ts",
    "migrate:make": "knex migrate:make --knexfile src/knexfile.ts",
    "seed": "knex seed:run --knexfile src/knexfile.ts",
    "fresh-start:reset": "tsx scripts/freshStartReset.ts",
    "stress:invoice-customers": "tsx scripts/stress_invoice_customer_monitor.ts",
    "stress:employee-payroll": "tsx scripts/stress_employee_payroll.ts",
    "stress:shift-history": "tsx scripts/stress_shift_history.ts",
    "test:compensation-plans": "tsx scripts/test_compensation_plans.ts",
    "test:employee-earnings": "tsx scripts/test_employee_earnings.ts",
    "test:employee-wage-safety": "tsx scripts/test_employee_wage_safety.ts",
    "test:payroll-ledger": "tsx scripts/test_payroll_ledger.ts",
    "test:payroll-schedules": "tsx scripts/test_payroll_schedules.ts",
    "test:shift-debt-receipts": "tsx scripts/test_shift_debt_receipts.ts",
    "test:receivable-payments": "tsx scripts/test_receivable_payment_integrity.ts",
    "test:invoice-consumption": "tsx scripts/test_invoice_consumption_controls.ts",
    "test:invoice-consumption-corrections": "tsx scripts/test_invoice_consumption_corrections.ts",
    "test:invoice-draft-reservations": "tsx scripts/test_invoice_draft_reservations.ts",
    "test:invoice-accounting": "tsx scripts/test_invoice_accounting_controls.ts",
    "test:receivable-reporting": "tsx scripts/test_receivable_reporting.ts",
    "test:invoice-consumption-history": "tsx scripts/test_invoice_consumption_history.ts",
    "test:delivery-policy": "tsx scripts/test_delivery_policy.ts",
    "test:delivery-replay": "tsx scripts/test_delivery_replay.ts",
    "audit:receivables": "tsx scripts/audit_receivable_integrity.ts",
    "maintenance:delivery-timestamps:dry-run": "tsx scripts/dry_run_delivery_timestamp_normalization.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "decimal.js-light": "^2.5.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.1",
    "knex": "^3.1.0",
    "shared": "*",
    "sqlite3": "^5.1.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
